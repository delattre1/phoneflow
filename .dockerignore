# Build context is the repo root; only the agent's own content belongs in it.
.git
.env
# `**/` is load-bearing: a bare `__pycache__` matches only the context root.
**/__pycache__
**/*.py[co]
**/.pytest_cache
# The live agent token `plow-agents mint` writes beside compose.yml.
plow-credentials
web/node_modules
web/dist
.superpowers
.venv
.pytest_cache
